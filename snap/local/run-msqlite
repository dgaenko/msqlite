#!/bin/sh
# msqlite запускается в strict-снапе.
#
# ~/.config недоступен через интерфейс home (скрытые каталоги), поэтому
# настройки и историю SQL держим в writable-каталоге снапа.
export XDG_CONFIG_HOME="$SNAP_USER_DATA/.config"

# snapd для strict-снапов подменяет HOME на каталог снапа. Возвращаем
# настоящий домашний каталог, чтобы диалоги сохранения/экспорта и недавние
# базы работали ожидаемо (доступ к нему даёт интерфейс home).
if [ -n "${SNAP_REAL_HOME:-}" ]; then
	HOME="$SNAP_REAL_HOME"
	export HOME
fi

# Если приложение запустили из каталога вне доступа снапа, snapd переводит
# процесс в /var/lib/snapd/void. Стартуем из домашнего каталога.
if [ "${PWD:-}" = "/var/lib/snapd/void" ] || [ ! -r . ]; then
	cd "$HOME" 2>/dev/null || cd / || true
fi

exec "$SNAP/bin/msqlite" "$@"
